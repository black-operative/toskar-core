#compdef toskarctl yggctl
# zsh completion for toskarctl

_toskarctl() {
  local -a commands
  commands=(
    'version:print the version, license, and source URL'
    'about:print the version, license, and source URL'
    'paths:print the data, model, runtime, log, and database directories'
    'automations:manage scheduled automations on the daemon'
    'mcp:connect an app such as Claude Desktop to Yggdrasil over MCP'
    'join:join this computer to a Yggdrasil network with a join command'
    'join-token:make, list, or revoke join tokens for adding computers'
    'network:show this computer'"'"'s network and paired computers'
    'leave:leave the network and forget paired computers'
    'completion:print a shell completion script'
  )

  if (( CURRENT == 2 )); then
    _describe -t commands 'toskarctl command' commands
    return
  fi

  case "${words[2]}" in
    mcp)
      _arguments '--url[Yggdrasil address]:url:'
      ;;
    completion)
      (( CURRENT == 3 )) && _values 'shell' bash zsh fish
      ;;
    join)
      _arguments '--server[address of the computer that made the command]:server:' \
        '--token[join token]:token:' '--fingerprint[that computer'"'"'s fingerprint]:fingerprint:' \
        '--name[rename this computer as it joins]:name:' '--wait[wait for Yggdrasil to start]:duration:' \
        '--output[output format]:format:(text json)'
      ;;
    join-token)
      if (( CURRENT == 3 )); then
        _values 'join-token command' create list revoke
        return
      fi
      _arguments '--ttl[how long the token lasts]:duration:' '--output[output format]:format:(text json)'
      ;;
    network|leave)
      _arguments '--output[output format]:format:(text json)'
      ;;
    automations)
      if (( CURRENT == 3 )); then
        _values 'automations command' list get create update delete run pause resume hook
        return
      fi
      case "${words[3]}" in
        create|update)
          local -a id
          [[ "${words[3]}" == update ]] && id=('1:automation id:')
          # _arguments reads words[1] as the command, so start at create or update.
          shift 2 words
          (( CURRENT -= 2 ))
          _arguments $id \
            '--name[automation name]:name:' \
            '--prompt[prompt to run]:prompt:' \
            '--profile[profile id]:profile:' \
            '--model[installed model id]:model:' \
            '--schedule[schedule kind]:schedule:(once daily weekly monthly interval cron manual)' \
            '--at[HH:MM, several such as 08:00,17:00, or RFC3339]:time:' \
            '--every[interval duration, such as 6h]:duration:' \
            '--weekday[days 0-6 or names, such as 1,3,5 or weekdays]:weekday:(weekdays 0 1 2 3 4 5 6)' \
            '--day[day of the month, 1-31]:day:' \
            '--cron[cron expression]:cron:' \
            '--zone[IANA time zone]:zone:' \
            '*--tool[tool id allowed for this automation]:tool:' \
            '--notify[notification mode]:mode:(always condition change none)' \
            '--condition-kind[condition kind]:kind:(threshold available significant)' \
            '--condition-op[condition operator]:op:(below above)' \
            '--condition-value[threshold value]:value:' \
            '--trigger[run only when it changed]:trigger:(page feed folder webhook after none)' \
            '--trigger-url[the page or feed to watch]:url:' \
            '--trigger-path[the folder or file to watch]:path:_files' \
            '--after[the automation it runs after]:automation id:' \
            '--after-when[when it runs after]:when:(succeeded notified)' \
            '--save-folder[also save each result in this folder]:folder:_files -/' \
            '--disabled[create the automation paused]'
          ;;
      esac
      ;;
  esac
}

if [[ "${funcstack[1]}" == "_toskarctl" ]]; then
  _toskarctl "$@"
else
  compdef _toskarctl toskarctl yggctl
fi
